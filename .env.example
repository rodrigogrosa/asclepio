# ============================================================
#  ASCLÉPIO — variáveis de ambiente (copie para .env)
#  Tudo tem default seguro para rodar local. Só o SECRET_KEY
#  PRECISA ser trocado em qualquer ambiente que não seja dev.
# ============================================================

# --- Aplicação -------------------------------------------------
APP_ENV=development                 # development | test | production
APP_NAME=Asclépio
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING
LOG_FORMAT=console                  # console | json (json em produção)

# --- Segurança -------------------------------------------------
SECRET_KEY=troque-esta-chave-por-algo-longo-e-aleatorio-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60

# --- Banco de dados ---------------------------------------------
# SQLite por padrão (zero configuração). Postgres no docker-compose.
DATABASE_URL=sqlite+aiosqlite:///./data/asclepio.sqlite
# DATABASE_URL=postgresql+asyncpg://asclepio:asclepio@localhost:5432/asclepio

# --- LLM --------------------------------------------------------
# Provedor: ollama (padrão, 100% local) | litellm (gateway, ver infra/litellm) | openai (API compatível) | fake (testes/CI)
LLM_PROVIDER=ollama
LLM_MODEL=asclepio-med               # modelo fine-tunado (criado por `make finetune` + `make export`)
LLM_FALLBACK_MODEL=llama3.1:8b       # usado se LLM_MODEL não existir no Ollama
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
OLLAMA_BASE_URL=http://localhost:11434   # usado pelo `make dev` (host)
# OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434   # usado pelos containers (o bootstrap preenche: host.docker.internal ou ollama)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- LiteLLM (gateway OpenAI-compatible; `make up-full` ou profile gateway) ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-asclepio-dev

# --- Embeddings / RAG -------------------------------------------
EMBEDDINGS_PROVIDER=ollama          # ollama | huggingface | fake
EMBEDDINGS_MODEL=nomic-embed-text
VECTORSTORE_DIR=./data/vectorstore
KNOWLEDGE_BASE_DIR=./data/knowledge_base
RAG_TOP_K=5
RAG_MIN_SCORE=0.25

# --- Observabilidade --------------------------------------------
ENABLE_METRICS=true                      # Prometheus em /metrics
# Langfuse (tracing de prompts/tokens/latência). `make up-full` sobe o Langfuse local com estas chaves já criadas.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-asclepio-local
LANGFUSE_SECRET_KEY=sk-lf-asclepio-local-secret
LANGFUSE_HOST=http://localhost:3001      # host (`make dev`); dentro do compose a API usa LANGFUSE_HOST_DOCKER (padrão http://langfuse-web:3000)
# Para Langfuse Cloud: use suas chaves e LANGFUSE_HOST=https://cloud.langfuse.com
# LangSmith (opcional): LANGCHAIN_TRACING_V2=true LANGCHAIN_API_KEY=... LANGCHAIN_PROJECT=asclepio

# --- Docker compose ---------------------------------------------
POSTGRES_PASSWORD=asclepio
API_PORT=8000
WEB_PORT=3000
LITELLM_PORT=4000
LANGFUSE_PORT=3001
MINIO_PORT=9090
MINIO_CONSOLE_PORT=9091
OLLAMA_PULL_MODELS=nomic-embed-text llama3.1:8b

# --- Frontend ---------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
